# Generated Android/build and local development state
.gradle/
.kotlin/
build/
out/
.externalNativeBuild/
.cxx/
.idea/
.vscode/
*.iml
local.properties
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Sensitive local configuration and signing material (never commit)
.env
.env.*
*.jks
*.keystore
*.p12
*.pfx
*.key
*.pem
google-services.json
secrets/
credentials.json
key.properties

# Generated packages, diagnostics and private captures
*.apk
*.aab
*.apks
*.log
*.hprof
*.pcap
*.pcapng
captures/

# Guest build outputs and VM disks; intentional adoption still requires review
guest-output/
*.img
*.qcow
*.qcow2
*.vdi
*.vmdk
*.vhd
*.vhdx
*.iso

# Native libraries/archives are deliberately not broadly ignored: review their
# appearance. The foundation validator rejects tracked binaries, even if forced.
